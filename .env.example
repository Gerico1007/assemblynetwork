# ♠️🌿🎸🧵 AssemblyNetwork Configuration

# Server Configuration
PORT=9000
NODE_ENV=development

# Upstash Redis Configuration (for activity logging)
# Get these from: https://console.upstash.com/
# OR reuse credentials from ~/..env (if using shared Trinity Redis)
UPSTASH_REDIS_REST_URL=https://loyal-lamb-40648.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Alternative token name (for compatibility with EchoThreads)
RESONANCE_TOKEN=your_redis_token_here

# Network Configuration
DEFAULT_SUBNET=192.168.7.0/24

# Custom Ports (optional - comma-separated)
# Add any additional ports to scan beyond the default common ports
# Example: CUSTOM_PORTS=10070,10071,12345
CUSTOM_PORTS=
